---
import { Icon, type IconName } from '../common/Icon';

interface Props {
  catalogueRef: string;
  resolvedCommitSha: string;
  licenseIdentifier: string | null;
}
const { catalogueRef, resolvedCommitSha, licenseIdentifier } = Astro.props;

const items: Array<{ icon: IconName; title: string; detail: string }> = [
  {
    icon: 'book',
    title: 'Open source',
    detail: licenseIdentifier ? `${licenseIdentifier}-licensed torch-dae` : 'torch-dae source available',
  },
  { icon: 'flask', title: 'Reproducible evidence', detail: 'Schema-validated cards' },
  { icon: 'layers', title: 'PyTorch ecosystem', detail: 'Standard PyTorch nn.Module interface' },
];
---

<footer class="home-footer">
  {
    items.map((item) => (
      <div class="home-footer-item">
        <span class="home-footer-icon"><Icon name={item.icon} /></span>
        <span>
          <strong>{item.title}</strong>
          <small>{item.detail}</small>
        </span>
      </div>
    ))
  }
  <div class="home-footer-item home-footer-ref">
    <span class="home-footer-icon"><Icon name="tag" /></span>
    <span>
      <strong>torch-dae catalogue</strong>
      <small title={`Resolved source commit ${resolvedCommitSha}`}>{catalogueRef}</small>
    </span>
  </div>
</footer>
