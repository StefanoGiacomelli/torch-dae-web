---
import { siteConfig } from '../../config/site';
import { ThemeToggle } from './ThemeToggle';

interface Props {
  active: 'models' | 'technical';
}

const { active } = Astro.props;

const externalLinks = [
  { label: 'GitHub', href: siteConfig.links.github },
  { label: 'Documentation', href: siteConfig.links.documentation },
  { label: 'PyPI', href: siteConfig.links.pypi },
];
---

<header class="navbar">
  <a class:list={["brand", { active: active === 'models' }]} href="/" aria-label="torch-dae Model Cards">
    <span class="brand-mark" aria-hidden="true">▥</span>
    <strong>{siteConfig.title}</strong>
  </a>
  <span class="tagline">{siteConfig.tagline}</span>
  <nav aria-label="Primary navigation">
    <ThemeToggle client:load />
    <a class:list={{ active: active === 'technical' }} href="/technical-cards">Technical Cards</a>
    <span class="navbar-external-links">
      {externalLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </span>
    <details class="navbar-more">
      <summary aria-label="More external links">
        More <span aria-hidden="true">⌄</span>
      </summary>
      <div class="navbar-more-menu">
        {externalLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </details>
  </nav>
</header>
