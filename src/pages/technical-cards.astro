---
import { TechnicalCardsExplorer } from '../components/technical-cards/TechnicalCardsExplorer';
import catalogueData from '../generated/catalogue.json';
import AppLayout from '../layouts/AppLayout.astro';
import type { CatalogueIndex } from '../data/types/catalogue';
import '../styles/technical-cards.css';

const catalogue = catalogueData as CatalogueIndex;
---

<AppLayout title="Technical Cards" active="technical">
  <section class="technical-page">
    <header class="technical-hero">
      <div>
        <p class="eyebrow">Technical evidence for real-world audio</p>
        <h1>Technical Cards</h1>
        <p>Runtime comparison, adaptive selectors, and canonical evidence.</p>
      </div>
      <aside aria-label="Catalogue summary">
        <strong>{catalogue.metadata.technicalCardCount}</strong> validated cards
        <span title={`Resolved source ${catalogue.metadata.resolvedCommitSha}`}>
          {catalogue.metadata.modelCount} canonical models · source {catalogue.metadata.requestedRef} · {catalogue.metadata.resolvedCommitSha.slice(0, 8)}
        </span>
      </aside>
    </header>
    <TechnicalCardsExplorer catalogue={catalogue} client:load />
  </section>
</AppLayout>
