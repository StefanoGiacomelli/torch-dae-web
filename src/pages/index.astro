---
import catalogueData from '../generated/catalogue.json';
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/model-cards.css';
import BackgroundMotif from '../components/model-cards/BackgroundMotif.astro';
import FooterStrip from '../components/model-cards/FooterStrip.astro';
import { Carousel } from '../components/model-cards/Carousel';
import { getReferenceRuntimeContext } from '../data/derive/referenceContext';
import { getEvidencedVerificationBackends } from '../data/derive/verification';
import type { CatalogueIndex } from '../data/types/catalogue';

const catalogue = catalogueData as CatalogueIndex;

const references = Object.fromEntries(
  catalogue.models.map((model) => [model.id, getReferenceRuntimeContext(model, catalogue)]),
);
const verificationBackends = Object.fromEntries(
  catalogue.models.map((model) => [model.id, getEvidencedVerificationBackends(model, catalogue)]),
);
---

<AppLayout title="Model Cards" active="models">
  <section class="home-page" data-model-count={catalogue.models.length}>
    <BackgroundMotif />

    <header class="home-header">
      <div>
        <p class="eyebrow">Scientific audio model explorer</p>
        <h1>Model Cards</h1>
        <p class="lede">Select a model to inspect</p>
      </div>
      <div class="home-header-side">
        <p class="home-header-claim">From audio to understanding.</p>
        <p class="home-header-note">Open models. Canonical evidence.</p>
      </div>
    </header>

    <Carousel
      client:load
      models={catalogue.models}
      metadata={catalogue.metadata}
      references={references}
      verificationBackends={verificationBackends}
    />

    <FooterStrip
      catalogueRef={`${catalogue.metadata.requestedRef} · ${catalogue.metadata.resolvedCommitSha.slice(0, 8)}`}
      licenseIdentifier={catalogue.metadata.licenseIdentifier}
    />
  </section>
</AppLayout>
