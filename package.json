{
  "name": "torch-dae-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "sync:data": "node --import tsx scripts/sync-data.ts",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "audit:comparability": "node --import tsx scripts/audit-comparability.ts",
    "audit:catalogue": "node --import tsx scripts/audit-catalogue.ts",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "audit:deployment": "node scripts/audit-deployment.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:chromium": "npm run build && playwright test --project=chromium",
    "test:a11y": "npm run build && playwright test --config=playwright.a11y.config.ts",
    "test:pages": "ASTRO_SITE_URL=https://stefanogiacomelli.github.io ASTRO_BASE_PATH=/torch-dae-web/ npm run build && playwright test --config=playwright.pages.config.ts",
    "prebuild": "npm run sync:data",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
